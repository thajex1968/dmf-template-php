# ==========================================================================
# DMF PHP Template — Environment Configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in real values for your deployment:
#     cp .env.example .env
#
# NEVER commit the real `.env` file. It is ignored by .gitignore.
# All values below are placeholders — do not use them in production.
# ==========================================================================

# --- Application ----------------------------------------------------------
APP_NAME="DMF Application"
APP_ENV=local            # local | staging | production
APP_DEBUG=true           # true in local/staging, false in production
APP_URL=http://localhost

# --- Database -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dmf_database
DB_USERNAME=dmf_user
DB_PASSWORD=change_me_secret

# --- Mail -----------------------------------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls      # tls | ssl | null
MAIL_FROM=no-reply@dmf.ac.th

# --- Localization & Session ----------------------------------------------
TIMEZONE=Asia/Bangkok
SESSION_TIMEOUT=1800     # seconds (1800 = 30 minutes)
