# ==========================================================================
# DMF PHP Template — .gitignore
# Production-ready ignore rules for PHP + Apache projects across all platforms.
# ==========================================================================

# --- Environment & secrets ------------------------------------------------
# Never commit real environment configuration. Only .env.example is tracked.
.env
.env.*
!.env.example

# --- Composer / dependencies ----------------------------------------------
/vendor/
composer.phar
# Lock file: keep it committed for applications; ignore only for libraries.
# composer.lock

# --- Storage: runtime-generated content -----------------------------------
# Keep the directory structure (.gitkeep) but ignore generated content.
/storage/cache/*
/storage/logs/*
/storage/uploads/*
!/storage/cache/.gitkeep
!/storage/logs/.gitkeep
!/storage/uploads/.gitkeep

# --- Logs -----------------------------------------------------------------
*.log
error_log

# --- PHP tooling caches ---------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.phpstan.cache/
.php-cs-fixer.cache
.php_cs.cache

# --- Apache ---------------------------------------------------------------
# Local overrides only; committed .htaccess (if any) is explicit.
.htpasswd

# --- Operating systems ----------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.fuse_hidden*
.nfs*

# --- Editors & IDEs -------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json

# JetBrains PhpStorm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo

# --- Build & temporary artifacts ------------------------------------------
/build/
/dist/
/tmp/
*.tmp
*.bak
*.cache
