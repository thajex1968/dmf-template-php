# ==========================================================================
# DMF PHP Template — .gitignore
# Production-ready ignore rules for PHP + Apache projects across all platforms.
# ==========================================================================

# --- Environment & secrets ------------------------------------------------
# Never commit real environment configuration. Only .env.example is tracked.
.env
.env.*
!.env.example

# --- Composer / dependencies ----------------------------------------------
/vendor/
composer.phar
# Lock file: keep it committed for applications; ignore only for libraries.
# Over a vcs repository the lock records a commit SHA and is reproducible, so
# it MUST stay tracked — it is what makes a build repeatable.
# composer.lock

# Composer credentials for the private dmf/core repository. Never commit.
auth.json

# --- DMF development mode -------------------------------------------------
# Generated by scripts/dmf-mode.php, derived from composer.json on every run.
# Committing composer-dev.json would reintroduce a "type": "path" repository
# into the tracked tree, which is exactly how a symlinked vendor/dmf/core
# reaches a release artifact and takes production down.
composer-dev.json
composer-dev.lock

# --- Release packages -----------------------------------------------------
# Built by scripts/build-release.php; published to GitHub Releases, not git.
/release/*.zip
/release/SHA256SUMS.txt

# --- Storage: runtime-generated content -----------------------------------
# Keep the directory structure (.gitkeep) but ignore generated content.
/storage/cache/*
/storage/logs/*
/storage/uploads/*
!/storage/cache/.gitkeep
!/storage/logs/.gitkeep
!/storage/uploads/.gitkeep

# --- Logs -----------------------------------------------------------------
*.log
error_log

# --- PHP tooling caches ---------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.phpstan.cache/
.php-cs-fixer.cache
.php_cs.cache

# --- Apache ---------------------------------------------------------------
# Local overrides only; committed .htaccess (if any) is explicit.
.htpasswd

# --- Operating systems ----------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.fuse_hidden*
.nfs*

# --- Editors & IDEs -------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json

# JetBrains PhpStorm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo

# --- Build & temporary artifacts ------------------------------------------
/build/
/dist/
/tmp/
*.tmp
*.bak
*.cache
